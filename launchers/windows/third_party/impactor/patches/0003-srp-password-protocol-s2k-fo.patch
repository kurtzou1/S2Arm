+
+/// S2Arm: SRP password key for the protocol Apple chose ("sp"): PBKDF2-HMAC-SHA256 over
+/// SHA-256(password) for "s2k", over its lowercase hex string for "s2k_fo".
+pub fn srp_password_key(password: &str, protocol: &str, salt: &[u8], iterations: u32) -> Result<[u8; 32], Error> {
+    let digest = Sha256::digest(password.as_bytes());
+    let hex_digest;
+    let input: &[u8] = match protocol {
+        "s2k" => &digest,
+        "s2k_fo" => {
+            hex_digest = hex::encode(digest);
+            hex_digest.as_bytes()
+        }
+        other => {
+            return Err(Error::AuthSrpWithMessage(
+                -1,
+                format!("S2A_SRP_PROTOCOL unsupported password protocol from Apple: {other}"),
+            ))
+        }
+    };
+    let mut key = [0u8; 32];
+    pbkdf2::pbkdf2::<hmac::Hmac<Sha256>>(input, salt, iterations, &mut key)?;
+    Ok(key)
+}
