+/// S2Arm: the steps of one Apple ID login, so the state machine below can be checked with a fake (patches/check/).
+#[allow(async_fn_in_trait)]
+pub trait LoginSteps {
+    async fn login_email_pass(&mut self, username: &str, password: &str) -> Result<LoginState, Error>;
+    async fn send_2fa_to_devices(&self) -> Result<LoginState, Error>;
+    async fn trusted_phone_numbers(&self) -> Vec<TrustedPhoneNumber>;
+    async fn verify_2fa(&self, code: String) -> Result<LoginState, Error>;
+    async fn send_sms_2fa_to_devices(&self, phone_id: u32) -> Result<LoginState, Error>;
+    async fn verify_sms_2fa(&self, code: String, body: crate::auth::VerifyBody) -> Result<LoginState, Error>;
+    fn has_pet(&self) -> bool;
+}
+
+impl LoginSteps for Account {
+    async fn login_email_pass(&mut self, username: &str, password: &str) -> Result<LoginState, Error> {
+        Account::login_email_pass(self, username, password).await
+    }
+    async fn send_2fa_to_devices(&self) -> Result<LoginState, Error> {
+        Account::send_2fa_to_devices(self).await
+    }
+    async fn trusted_phone_numbers(&self) -> Vec<TrustedPhoneNumber> {
+        self.get_auth_extras().await.map(|e| e.trusted_phone_numbers).unwrap_or_default()
+    }
+    async fn verify_2fa(&self, code: String) -> Result<LoginState, Error> {
+        Account::verify_2fa(self, code).await
+    }
+    async fn send_sms_2fa_to_devices(&self, phone_id: u32) -> Result<LoginState, Error> {
+        Account::send_sms_2fa_to_devices(self, phone_id).await
+    }
+    async fn verify_sms_2fa(&self, code: String, body: crate::auth::VerifyBody) -> Result<LoginState, Error> {
+        Account::verify_sms_2fa(self, code, body).await
+    }
+    fn has_pet(&self) -> bool {
+        self.get_pet().is_some()
+    }
+}
+
+/// Marker in the error text when Apple accepted a code and then asked for 2FA again (the launcher maps it to a player message).
+pub const REPEAT_2FA_MARKER: &str = "S2A_2FA_REPEAT";
+
+/// The login state machine. S2Arm change: after Apple accepts a 2FA code (device or SMS), log in again at most once to pick up
+/// the trusted session; if that login asks for 2FA again, stop with REPEAT_2FA_MARKER instead of asking the player for codes
+/// forever (upstream looped: verify → NeedsLogin → secondaryAuth → new SMS → …).
+pub async fn drive_login<S: LoginSteps, G: Fn(TwoFactorRequest) -> Result<TwoFactorAction, String>>(
+    s: &mut S,
+    username: &str,
+    password: &str,
+    tfa_closure: &G,
+) -> Result<(), Error> {
+    let mut response = s.login_email_pass(username, password).await?;
+    // Cached so the caller can be offered an SMS fallback even when a trusted
+    // device handled the push. Fetched lazily the first time 2FA is needed.
+    let mut trusted_phone_numbers: Vec<TrustedPhoneNumber> = Vec::new();
+    let mut code_accepted = false;
+    let repeat = || {
+        Error::AuthSrpWithMessage(
+            -2,
+            format!("{REPEAT_2FA_MARKER}: Apple accepted the verification code but asked for another one on the next sign-in"),
+        )
+    };
+
+    loop {
+        match response {
+            LoginState::NeedsDevice2FA | LoginState::Needs2FAVerification | LoginState::NeedsSMS2FA if code_accepted => {
+                return Err(repeat());
+            }
+            LoginState::NeedsDevice2FA => {
+                response = s.send_2fa_to_devices().await?;
+                if trusted_phone_numbers.is_empty() {
+                    trusted_phone_numbers = s.trusted_phone_numbers().await;
+                }
+            }
+            LoginState::Needs2FAVerification => {
+                if trusted_phone_numbers.is_empty() {
+                    trusted_phone_numbers = s.trusted_phone_numbers().await;
+                }
+                let request = TwoFactorRequest {
+                    method: TwoFactorMethod::Device,
+                    trusted_phone_numbers: trusted_phone_numbers.clone(),
+                };
+                match tfa_closure(request).map_err(|e| {
+                    Error::AuthSrpWithMessage(0, format!("Failed to get 2FA code: {}", e))
+                })? {
+                    TwoFactorAction::SubmitCode(code) => response = s.verify_2fa(code).await?,
+                    TwoFactorAction::SendSms(id) => response = s.send_sms_2fa_to_devices(id).await?,
+                }
+            }
+            LoginState::NeedsSMS2FA => {
+                if trusted_phone_numbers.is_empty() {
+                    trusted_phone_numbers = s.trusted_phone_numbers().await;
+                }
+                let id = trusted_phone_numbers.first().map(|p| p.id).unwrap_or(1);
+                response = s.send_sms_2fa_to_devices(id).await?;
+            }
+            LoginState::NeedsSMS2FAVerification(body) => {
+                let request = TwoFactorRequest {
+                    method: TwoFactorMethod::Sms,
+                    trusted_phone_numbers: trusted_phone_numbers.clone(),
+                };
+                match tfa_closure(request).map_err(|e| {
+                    Error::AuthSrpWithMessage(0, format!("Failed to get SMS 2FA code: {}", e))
+                })? {
+                    TwoFactorAction::SubmitCode(code) => response = s.verify_sms_2fa(code, body).await?,
+                    TwoFactorAction::SendSms(id) => response = s.send_sms_2fa_to_devices(id).await?,
+                }
+            }
+            LoginState::NeedsLogin => {
+                // only verify_2fa / verify_sms_2fa return NeedsLogin: a code was just accepted
+                if code_accepted {
+                    return Err(repeat());
+                }
+                code_accepted = true;
+                response = s.login_email_pass(username, password).await?
+            }
+            LoginState::LoggedIn => return Ok(()),
+            LoginState::NeedsExtraStep(step) => {
+                return if s.has_pet() { Ok(()) } else { Err(Error::ExtraStep(step)) };
+            }
+        }
+    }
+}
