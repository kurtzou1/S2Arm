 pub const FALLBACK_ANISETTE_URL_V3: &str = "https://ani.sidestore.io";
+pub mod identity;
 pub const V3_URL_FILE: &str = "anisette-v3-url";
 
-/// S2Arm: provisioning state file for a v3 server ("state.plist" for the default one)
+/// S2Arm: provisioning state file for a v3 server and the machine identity it was provisioned under
+/// ("state-<identity>.plist" for the default server, "state-<host>-<identity>.plist" otherwise). State provisioned under
+/// another identity (older builds: "state.plist" / "state-<host>.plist", provisioned with the server's own client info) is
+/// not reused: signing in with an identity that differs from the provisioning one fails with SRP -22410 (identity.rs).
 pub fn state_file_name(url: &str) -> String {
+    let tag = identity::identity_tag();
     if url.trim_end_matches('/') == DEFAULT_ANISETTE_URL_V3 {
-        return "state.plist".to_string();
+        return format!("state-{tag}.plist");
     }
     let host: String = url.split("://").last().unwrap_or(url).trim_end_matches('/')
         .chars().map(|c| if c.is_ascii_alphanumeric() || c == '.' || c == '-' { c } else { '_' }).collect();
-    format!("state-{host}.plist")
+    format!("state-{host}-{tag}.plist")
 }
 
