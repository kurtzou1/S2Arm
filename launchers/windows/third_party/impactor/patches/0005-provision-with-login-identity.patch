new file mode 100644
index 0000000..a18f065
--- /dev/null
+++ b/3rdparty/omnisette/src/identity.rs
@@ -0,0 +1,66 @@
+//! S2Arm: the machine identity Apple sees (model, OS, build, akd User-Agent) — one source for anisette provisioning and
+//! for every request plume_core sends to Apple. Apple trusts a login only from the machine identity the anisette data was
+//! provisioned under: provisioning with the anisette server's own value while signing in with another one makes the sign-in
+//! after a 2FA code fail with SRP -22410 (from 11-21; SideStore/SideStore#1749: changing Client Info without re-provisioning
+//! gives -22410, re-provisioning under the same value fixes it). Provisioning state is therefore stored per identity
+//! (identity_tag), so a change of identity provisions afresh instead of reusing state made under another one.
+
+use sha2::{Digest, Sha256};
+
+/// S2Arm: the machine identity sent to Apple (model, OS, build), one coherent triple for the whole login.
+/// macOS: this Mac's own model and OS (what Apple's own AuthKit sends); elsewhere a fixed real Mac.
+pub fn apple_client_info() -> &'static str {
+    &machine().0
+}
+
+/// S2Arm: akd's User-Agent for the same machine (its CFNetwork and Darwin versions).
+pub fn apple_user_agent() -> &'static str {
+    &machine().1
+}
+
+// One real Mac, all values read together off it on 11-20; used off macOS or when this Mac's values can't be read.
+const PINNED: [&str; 5] = ["Mac17,6", "27.2.1", "26B131", "3896.200.61", "27.2.0"];
+
+fn machine() -> &'static (String, String) {
+    static V: std::sync::OnceLock<(String, String)> = std::sync::OnceLock::new();
+    V.get_or_init(|| {
+        let [model, os, build, cfnetwork, darwin] = read_this_mac().unwrap_or(PINNED.map(String::from));
+        (
+            format!("<{model}> <Mac OS X;{os};{build}> <com.apple.AuthKit/1 (com.apple.akd/1.0)>"),
+            format!("akd/1.0 CFNetwork/{cfnetwork} Darwin/{darwin}"),
+        )
+    })
+}
+
+#[cfg(target_os = "macos")]
+fn read_this_mac() -> Option<[String; 5]> {
+    let run = |cmd: &str, args: &[&str]| -> Option<String> {
+        let o = std::process::Command::new(cmd).args(args).output().ok()?;
+        let v = String::from_utf8(o.stdout).ok()?.trim().to_string();
+        (o.status.success() && !v.is_empty() && !v.contains(['<', '>', ';', '\n', ' '])).then_some(v)
+    };
+    let cf: plist::Dictionary =
+        plist::from_file("/System/Library/Frameworks/CFNetwork.framework/Resources/Info.plist").ok()?;
+    let cfnetwork = cf.get("CFBundleVersion")?.as_string()?.to_string();
+    Some([
+        run("/usr/sbin/sysctl", &["-n", "hw.model"])?,
+        run("/usr/bin/sw_vers", &["-productVersion"])?,
+        run("/usr/bin/sw_vers", &["-buildVersion"])?,
+        cfnetwork,
+        run("/usr/bin/uname", &["-r"])?,
+    ])
+}
+
+#[cfg(not(target_os = "macos"))]
+fn read_this_mac() -> Option<[String; 5]> {
+    None
+}
+
+/// Short fingerprint of the identity (client info + User-Agent): part of the provisioning state file name
+pub fn identity_tag() -> String {
+    let mut h = Sha256::new();
+    h.update(apple_client_info().as_bytes());
+    h.update(b"\n");
+    h.update(apple_user_agent().as_bytes());
+    hex::encode(&h.finalize()[..4])
+}
