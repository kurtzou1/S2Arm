<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Protocol/Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 手动更新守门（PackCases：自动更新循环只发现、不装机）读 App 源码，只拷不编 -->
    <None Include="../App/PhoneAutoUpdate.cs" Link="AppSource/PhoneAutoUpdate.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../App/LibraryPage.cs" Link="AppSource/LibraryPage.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../App/ExportPages.cs" Link="AppSource/ExportPages.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../App/JobSlots.cs" Link="AppSource/JobSlots.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../App/UpdateFlow.cs" Link="AppSource/UpdateFlow.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- #1961「更新这款」要整款重出时接着重出：接线检查读 App 源码（UpdateRepackCases），只拷不编 -->
    <None Include="../App/ExportFlow.cs" Link="AppSource/ExportFlow.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
