<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>S2Arm</AssemblyName>
    <ApplicationIcon>Assets/S2Arm.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 不自带 .NET：用随包 Runtime\dotnet（出包作业本来就要这份，bundle_runtime_win.py）。原先自包含单文件把同一份运行时又打进 exe 一次（0.2.8 exe 98.7 MB）。
         按 exe 所在目录找（AppRelative），不看系统装没装 .NET、不看 DOTNET_ROOT，玩家机照旧零安装。
         平台由发版命令给（dotnet publish -r win-x64，不要再带 \-\-self-contained true）；这里不写死 RID，免得引用本工程的 Mac 端测试也去编 Windows 启动壳 -->
    <SelfContained>false</SelfContained>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>Runtime\dotnet</AppHostRelativeDotNet>
    <DebugType>embedded</DebugType>
    <!-- 文件属性里的版本号（11-09 合入运维：曾显示 1.0.0+944ad83…）：构建时从最近的发版 tag 取，同 launchers/macos/build_app.py release_identity；不拼提交号 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- 版本号来源（同 pack/jobs/core.py release_version）：构建参数 S2ArmVersion=x.y.z 显式给的优先；HEAD 正好落在发版 tag 上用它；
       否则取全部 v* tag 里版本号最大的（不用 git describe：热修 tag 0.2.7–0.2.9 打在热修分支上、不在 main 的祖先里，describe 在 main 上只摸到 v0.2.6）；都没有用 0.1.0 -->
  <Target Name="S2ArmVersionFromTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;GenerateNuspec">
    <Exec Condition="'$(S2ArmVersion)' == ''" Command="git tag --list v* --sort=-v:refname" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="S2ArmTag" />
    </Exec>
    <!-- 顶栏版本号（11-11 维护者，同 Mac build_app.py）：HEAD 正好是发版 tag 且没改动 = 正式版「0.3.0」；否则开发版「<版本>-dev+<短提交号>」。界面前面加 v -->
    <Exec Command="git tag --points-at HEAD --list v* --sort=-v:refname" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="S2ArmExactTag" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="S2ArmCommit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="S2ArmDirty" />
    </Exec>
    <PropertyGroup>
      <S2ArmExactVersion>$([System.Text.RegularExpressions.Regex]::Match('$(S2ArmExactTag)', '\d+(\.\d+)*').Value)</S2ArmExactVersion>
      <S2ArmVersion Condition="'$(S2ArmVersion)' == ''">$(S2ArmExactVersion)</S2ArmVersion>
      <S2ArmVersion Condition="'$(S2ArmVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(S2ArmTag)', '\d+(\.\d+)*').Value)</S2ArmVersion>
      <S2ArmVersion Condition="'$(S2ArmVersion)' == ''">0.1.0</S2ArmVersion>
      <S2ArmDisplayVersion>$(S2ArmVersion)-dev+$(S2ArmCommit)</S2ArmDisplayVersion>
      <S2ArmDisplayVersion Condition="'$(S2ArmDirty)' == '' and '$(S2ArmExactVersion)' == '$(S2ArmVersion)'">$(S2ArmVersion)</S2ArmDisplayVersion>
      <S2ArmDisplayVersion Condition="'$(S2ArmCommit)' == ''">$(S2ArmVersion)</S2ArmDisplayVersion>
      <Version>$(S2ArmVersion)</Version>
      <FileVersion>$(S2ArmVersion)</FileVersion>
      <AssemblyVersion>$(S2ArmVersion)</AssemblyVersion>
      <InformationalVersion>$(S2ArmDisplayVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <EmbeddedResource Include="../../../shared/experience.v1.json" LogicalName="S2Arm.experience.v1.json" />
    <!-- 作业层文字的英文对照表：和 Mac 适配层同一份（BackendText），不在 Windows 存副本 -->
    <EmbeddedResource Include="../../../macos/adapter/Sources/S2ArmAppleAdapter/Resources/Localizable.json" LogicalName="S2Arm.Localizable.json" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/S2Arm.ico" />
    <AvaloniaResource Include="../../../macos/Branding/AppIcon-1024.png" Link="Assets/AppIcon.png" />
    <AvaloniaResource Include="../../../macos/Branding/wordmark-transparent.png" Link="Assets/Wordmark.png" />
    <None Update="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/Manrope-OFL.txt" />
  </ItemGroup>
</Project>
