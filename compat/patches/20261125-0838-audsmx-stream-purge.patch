+                }
+
+                uint write = _memory.Read<uint>(Buffer + ClientBlockOffset + IndexOffset);
+                int filled = write < (uint)_capacity ? ((int)write - _read + _capacity) % _capacity : 0;
+                int purged = frameCount > 0 ? Math.Min(frameCount, filled) : filled;
+                _read = (_read + purged) % _capacity;
+                _queued = _read;
+                _memory.Write(Buffer + ServerBlockOffset + IndexOffset, (uint)_read);
+                DataEvent?.Signal();
+
+                return purged;
+            }
+        }
