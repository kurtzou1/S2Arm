+        //   已交给宿主、还没播完的块一并作废（同 Detach），回写读指针、触发数据事件；返回清掉的帧数
+        public int Purge(int frameCount)
+        {
+            lock (_lock)
+            {
+                if (_attached)
+                {
+                    CollectReleased();
+                    _output.FlushBuffers();
+                    _output.GetReleasedBuffer(_released, out _);
