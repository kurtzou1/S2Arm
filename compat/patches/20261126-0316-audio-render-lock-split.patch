+                    shadow.EffectIsNew[i] = parameter.IsNew;
+                }
+            }
+            else
+            {
+                for (int i = 0; i < effectCount; i++)
+                {
+                    ref readonly EffectInParameterVersion1 parameter = ref scan.GetRefOrRefToCopy<EffectInParameterVersion1>(out _);
