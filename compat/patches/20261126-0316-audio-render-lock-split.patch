+                Console.Error.WriteLine($"[声] 输出 #{_diag.Index}：设备 IO 周期 {_deviceIOFrames} → {ioFrames} 帧,拉取环 {old} → {S2ADeriveRingFrames(ioFrames)} 帧(只增不减地换,#2157 评审 #15)");
