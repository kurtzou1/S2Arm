+            _mixes.Span.CopyTo(shadow._mixes.Span);
+            _sortedMixes.Span.CopyTo(shadow._sortedMixes.Span);
+            EdgeMatrix.S2ACopyTo(shadow.EdgeMatrix);
+        }
