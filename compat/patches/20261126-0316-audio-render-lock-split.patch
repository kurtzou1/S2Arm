+                        }
+                    }
+                    else if (Volatile.Read(ref s._virtual))
+                    {
+                        s.S2AVirtualProbe(now);
+                    }
+                    else
+                    {
+                        s.S2ACheckStall(now);
+                    }
+                }
+            }
+        }
