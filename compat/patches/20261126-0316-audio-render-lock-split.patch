+            {
+                return;
+            }
+
+            SequenceReader<byte> scan = new(input);
+
+            scan.Advance(headerSizes.BehaviourSize + headerSizes.MemoryPoolsSize + headerSizes.VoiceResourcesSize + headerSizes.VoicesSize);
