  "allowlist": [
    {
      "id": "upstream_inkscape_export_path",
      "categories": [
        "home_path"
      ],
      "paths": [
        "compat/tree/src/Ryujinx.HLE/HOS/Applets/SoftwareKeyboard/Resources/*.svg"
      ],
      "regex": "caian",
      "line_regex": "inkscape:export-filename=",
      "reason": "上游 Ryujinx（MIT）原样 SVG 里 Inkscape 记下的原作者导出路径；compat/tree 须与上游逐字节一致（verify.sh 核对），不改。"
    },
