{
  "version": 1,
  "content_rules": [
    {
      "id": "home",
      "category": "home_path",
      "regex": "(?<![\\w$})])(?:/Users/|/home/|/Volumes/|[A-Za-z]:[\\\\/]Users[\\\\/])([\\w.-]+)",
      "group": 1
    },
    {
      "id": "udid",
      "category": "device_id",
      "regex": "\\b[0-9A-Fa-f]{8}-[0-9A-Fa-f]{16}\\b"
    },
    {
      "id": "legacy_udid",
      "category": "device_id",
      "regex": "\\b(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})\\b",
      "context": "(?i)udid|coredevice|device[_ -]?(?:id|identifier)|硬件标识"
    },
    {
      "id": "usb_serial",
      "category": "device_id",
      "regex": "\\b[0-9A-Fa-f]{24}\\b",
      "context": "(?i)udid|coredevice|device[_ -]?(?:id|identifier)|serialnumber|硬件标识"
    },
    {
      "id": "udid_prefix_literal",
      "category": "device_id",
      "regex": "[\"']([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4})[\"']",
      "group": 1
    },
    {
      "id": "team_assignment",
      "category": "team_id",
      "regex": "(?i)(?:S2A_TEAM_DEFAULT|DEVELOPMENT_TEAM|DevelopmentTeam|team_?id|TEAM|团队号)[\"\\x27]?\\s*[=:：]\\s*[\"\\x27]?([a-z0-9]{10})(?![a-z0-9])",
      "group": 1
    },
    {
      "id": "team_literal",
      "category": "team_id",
      "regex": "[\"']((?=[A-Z0-9]{10}[\"'])(?=[A-Z0-9]*[A-Z])(?=[A-Z0-9]*[0-9])[A-Z0-9]{10})[\"']",
      "group": 1
    },
    {
      "id": "team_bundle",
      "category": "team_id",
      "regex": "(?i)\\bs2arm\\.((?=[a-z0-9]{0,9}[0-9])[a-z0-9]{10})\\.[a-z0-9_-]+",
      "group": 1
    },
    {
      "id": "email",
      "category": "email",
      "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
    },
    {
      "id": "maintainer_login",
      "category": "internal_name",
      "regex": "(?<![A-Za-z0-9_-])jhz(?![A-Za-z0-9_-])"
    },
    {
      "id": "maintainer_alias",
      "category": "internal_name",
      "regex": "总指挥|天眼(?:（Windows 出包机）|\\(Windows 出包机\\))?"
    },
    {
      "id": "internal_line_name",
      "category": "internal_name",
      "messages_only": true,
      "regex": "(?:主线线|合入运维线|运维线|启动器线|出包修复线|质量线|新功能线|迁仓线|单壳线|Switch ?2 ?线|满屏补丁线|满屏线|普查线|帧率能耗线|能耗线|一次成功线|画质性能线|性能线|体验线|合入线|列车线|众包线|直连线|出包速度线|卡顿线|Windows ?出包线)(?![程性路索条框])"
    },
    {
      "id": "internal_device_word",
      "category": "internal_name",
      "regex": "测试机"
    },
    {
      "id": "private_host_mini",
      "category": "internal_name",
      "regex": "(?<![A-Za-z0-9_./-])(?<!iPad )(?<!Mac )(?<!mac )mini(?![A-Za-z0-9_-])"
    },
    {
      "id": "private_host_mini_files",
      "category": "internal_name",
      "regex": "(?<![A-Za-z0-9_])mac[-_]mini(?![A-Za-z0-9_])|(?<![A-Za-z0-9_])mini_sync(?![A-Za-z0-9_])|(?<![A-Za-z0-9_])mini_main(?![A-Za-z0-9_])"
    },
    {
      "id": "private_host_air",
      "category": "internal_name",
      "regex": "(?<![A-Za-z0-9_./-])(?<!iPad )(?<!MacBook )(?<!Kirby )Air(?![A-Za-z0-9_-])|(?<![A-Za-z0-9_])mac[-_]air(?![A-Za-z0-9_])"
    },
    {
      "id": "compliance_readme_decrypt_tools",
      "category": "compliance_copy",
      "regex": "(?i)libhac|hactool",
      "paths": [
        "README.md",
        "README.*.md",
        "docs/site/index.html"
      ],
      "reason_note": "11-09 维护者批合规文案：README / 下载页不单列解密相关组件；许可声明留在 NOTICE / THIRD_PARTY_LICENSES"
    },
    {
      "id": "compliance_first_party_titles",
      "category": "compliance_copy",
      "regex": "(?i)(?:塞尔达|旷野之息|王国之泪|时之笛|马力欧|马里奥|马车8|动森|动物森友会|宝可梦|斯普拉遁|喷射战士|异度神剑|火焰纹章|星之卡比|密特罗德|银河战士|皮克敏|大乱斗|大金刚|脑锻炼|健身环|奇诺比奥|奥德赛|Zelda|Mario|Animal Crossing|Pok[eé]mon|Pokopia|Splatoon|Xenoblade|Fire Emblem|Kirby|Metroid|Pikmin|Smash Bros|Donkey Kong|Ring Fit|Captain Toad|Ocarina of Time|Tears of the Kingdom|Breath of the Wild|\\bacnh\\b|\\bbotw\\b|\\btotk\\b|\\bmk8d?\\b|\\bsmg2\\b|\\bxc3\\b|猎天使魔女|魔兵惊天录|Bayonetta|异界锁链|Astral Chain|耀西|\\bYoshi\\b|路易吉|\\bLuigi\\b|瓦力欧|\\bWario\\b|星际火狐|Star Fox|高级战争|Advance Wars|1-2-Switch|超级机器人大战X?|Daemon X Machina|机甲战魔)|(?-i:\\bARMS\\b)",
      "paths": [
        "README.md",
        "README.*.md",
        "docs/site/*",
        "docs/validation/*",
        "docs/兼容性清单.md",
        "docs/名单_*",
        "docs/名单_*/*", "docs/*.md"
      ],
      "messages": true, "reason_note": "11-09 维护者批统一规则：公开仓不出现任天堂第一方游戏名（11-10 jhz 定：第一方按「任天堂发行」算，不论哪家工作室开发，如猎天使魔女 2 / 3、异界锁链）；第三方只在说明性场合保留。先管给人看的文档与名单（11-09 晚起含 docs/ 下全部 Markdown，坑记录也算）与提交信息（messages: true），代码注释另议；pack/display_names.tsv 第一列是与 pack/oneclick/titles.tsv 对上的内部键，不在本规则内（显示名已是程序号）"
    }
  ],
  "metadata_rules": [
    {
      "category": "game_macro",
      "globs": [
        "*.mme",
        "graphics/tools/macrogen/corpus/*",
        "*/s2amacrotable.g.cs",
        "s2amacrotable.g.cs"
      ]
    },
    {
      "category": "game_screenshot",
      "globs": [
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.webp",
        "*.gif",
        "*.bmp",
        "*.tiff",
        "*.heic"
      ]
    }
